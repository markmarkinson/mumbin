{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mumbin",
  "version": "0.1.0",
  "identifier": "de.markmarkinson.mumbin",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Mumbin",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"],
    "publisher": "markMarkinson",
    "copyright": "Copyright (c) markMarkinson",
    "category": "Productivity",
    "shortDescription": "Portable wiki notes"
  }
}
