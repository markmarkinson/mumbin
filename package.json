  "private": true,
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "vendor": "node scripts/buildVendor.js",
    "dist:portable": "node scripts/buildPortable.js",
